APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
# Optional: base URL embedded in emails when APP_URL is loopback (phone/email apps cannot open 127.0.0.1).
# Use the Network URL printed by `php artisan serve --host=0.0.0.0`, e.g. http://192.168.1.9:8000
# APP_PUBLIC_URL=http://192.168.1.9:8000
APP_TIMEZONE=Asia/Manila

# Optional: bind artisan serve on every interface (phones still open the printed LAN IPv4).
# SERVER_HOST=0.0.0.0
# SERVER_PORT=8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=5256000
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local development uses Gmail SMTP. Railway Hobby blocks outbound SMTP (ports 25, 465, 587),
# so production must use Resend over HTTPS:
#   MAIL_MAILER=resend
#   RESEND_API_KEY=re_...
#   MAIL_FROM_ADDRESS=noreply@your-verified-domain
# Verify the domain in Resend (DNS SPF and DKIM) before sending. Resend cannot send as @gmail.com.
# After changing any mail value, run: php artisan config:clear
# Workflow mail is sent after the web response. Failed sends are retried on the default queue.
# Do not commit the App Password or the Resend API key.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME="your-sending-gmail@gmail.com"
MAIL_PASSWORD="your-google-app-password"
MAIL_ENCRYPTION=tls
MAIL_TIMEOUT=20
MAIL_FROM_ADDRESS="your-sending-gmail@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
# Optional: pin the Vite HMR host when automatic LAN detection is wrong.
# VITE_DEV_HOST=192.168.1.5
